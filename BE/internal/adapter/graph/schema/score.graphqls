type Score {
  id: ID!
  contestantId: String!
  roundId: String!
  sbd: String!
  totalScore: Float!
  criteriaScores: Map # JSON object
  comment: String
  createdAt: Time!
}

scalar Map

extend type Query {
  myScores: [Score!]!
}

input ScoreInput {
  contestantId: String!
  sbd: String!
  criteriaScores: Map!
  comment: String
}

extend type Mutation {
  submitScore(input: ScoreInput!): Score!
}
